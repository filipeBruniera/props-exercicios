---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import { bairros, outrasLocalidades } from '../../data/bairros';
import { breadcrumbSchema } from '../../data/schema';

const title = 'Bairros Atendidos em Ubatuba | Desentupidora 24h M & C';
const description = 'A M & C Desentupidora atende todos os bairros de Ubatuba-SP: Centro, Itaguá, Praia Grande, Enseada, Maranduba, Lázaro, Itamambuca, Picinguaba e mais.';
const crumbs = [{ name: 'Início', path: '/' }, { name: 'Bairros atendidos', path: '/bairros' }];
const regioes = ['Região Sul', 'Região Central', 'Região Norte'] as const;
---
<Base title={title} description={description} path="/bairros" schema={[breadcrumbSchema(crumbs)]}>
  <section class="section">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <h1>Bairros atendidos em Ubatuba</h1>
      <p class="lead">Atendemos o município inteiro, 24 horas. Escolha o seu bairro para ver os serviços mais pedidos na região.</p>
      <div class="regs">
        {regioes.map((r) => (
          <section class="reg reveal" aria-label={r}>
            <h2>{r}</h2>
            <ul>
              {bairros.filter((b) => b.regiao === r).map((b) => (
                <li><a href={`/bairros/${b.slug}`}><strong>{b.nome}</strong><span>{b.intro}</span></a></li>
              ))}
            </ul>
          </section>
        ))}
      </div>
      <p class="muted more">Também atendemos {outrasLocalidades.join(', ')} e todas as demais localidades de Ubatuba.</p>
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .regs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-top: 40px; align-items: start; }
  .reg { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; }
  .reg h2 { font-size: 1.15rem; color: var(--accent); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  li a { display: grid; gap: 2px; padding: 12px; margin-inline: -12px; border-radius: 12px; text-decoration: none; color: var(--ink); }
  li a:hover { background: var(--surface-2); color: var(--ink); }
  li span { color: var(--muted); font-size: 0.9rem; }
  .more { margin-top: 32px; max-width: 80ch; }
  @media (max-width: 900px) { .regs { grid-template-columns: 1fr; } }
</style>
