---
import Base from '../layouts/Base.astro';
---
<Base title="Página não encontrada | M & C Desentupidora" description="Esta página não existe. Volte ao início ou chame a M & C Desentupidora em Ubatuba." path="/404" noindex>
  <section class="section on-dark">
    <div class="wrap">
      <h1>Página não encontrada</h1>
      <p class="lead">O endereço pode ter mudado. Escolha um caminho:</p>
      <div class="btn-row">
        <a class="btn btn-yellow" href="/">Ir para o início</a>
        <a class="btn btn-outline" href="/servicos">Ver serviços</a>
      </div>
    </div>
  </section>
</Base>
