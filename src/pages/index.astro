---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Foto from '../components/Foto.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import PhoneChat from '../components/PhoneChat.astro';
import Mascote from '../components/Mascote.astro';
import Jornada from '../components/Jornada.astro';
import { site, telHref, waHref } from '../data/site';
import { servicos } from '../data/servicos';
import { bairros, outrasLocalidades } from '../data/bairros';
import { faqHome } from '../data/faq';
import { faqSchema } from '../data/schema';

const title = 'Desentupidora em Ubatuba 24h | M & C Desentupidora';
const description =
  'Desentupidora em Ubatuba-SP com atendimento 24 horas. Pia, vaso, ralo, esgoto, caixa de gordura e fossa. Sem quebra na maioria dos casos. Chame no WhatsApp.';

const regioes = [
  { nome: 'Região Norte', desc: 'Itamambuca a Picinguaba' },
  { nome: 'Região Central', desc: 'Centro, orla e arredores' },
  { nome: 'Região Sul', desc: 'Toninhas ao Sertão da Quina' },
] as const;

const garantias = [
  { icon: 'clock', t: 'Plantão 24h', d: 'Noite, fim de semana, feriado e temporada.' },
  { icon: 'house-line', t: 'Sem quebra-quebra', d: 'Trabalhamos por dentro do cano.' },
  { icon: 'receipt', t: 'Preço antes', d: 'Você aprova o valor antes de começarmos.' },
  { icon: 'map-pin', t: 'Toda Ubatuba', d: 'Do Sertão da Quina a Picinguaba.' },
];

const emergencia = [
  { t: 'Pare de usar', d: 'Não dê descarga nem abra torneiras ligadas ao ponto entupido.' },
  { t: 'Feche o registro', d: 'Se o esgoto estiver voltando, feche o registro geral da casa.' },
  { t: 'Nada de soda', d: 'Soda cáustica endurece a gordura e pode estragar o cano.' },
  { t: 'Chame a M & C', d: 'Mande foto e bairro pelo WhatsApp. Já orientamos pelo chat.' },
];

const equipamentos = [
  { foto: 'maquina-rotativa', icon: 'pipe-wrench', t: 'Máquina rotativa', d: 'Cabo de aço com ponteiras para cada diâmetro. Abre pia, vaso, ralo e rede sem quebrar piso.' },
  { foto: 'hidrojateamento', icon: 'drop-half', t: 'Hidrojateadora', d: 'Jato de água em alta pressão que raspa gordura, areia de praia e raiz da parede do cano.' },
  { foto: 'caminhao', icon: 'truck', t: 'Caminhão de sucção', d: 'Esgota fossa séptica e caixa de gordura com destinação correta do resíduo.' },
];
---
<Base title={title} description={description} path="/" schema={[faqSchema(faqHome)]}>
  <!-- HERO -->
  <section class="hero on-dark grid-bg">
    <div class="hero-photo"><Foto nome="hero" alt="Técnico da M & C Desentupidora em atendimento em Ubatuba" prioridade sizes="100vw" widths={[800, 1280, 1920]} /></div>
    <div class="wrap hero-grid">
      <div class="hero-copy enter">
        <span class="tag"><span>Plantão 24 horas</span></span>
        <h1>Desentupidora em Ubatuba<span class="slogan">A gente faz a água <em>correr</em>.</span></h1>
        <p class="lead">Pia, vaso, ralo, esgoto, caixa de gordura e fossa. Chegamos com o equipamento certo e resolvemos sem quebrar a casa.</p>
        <a class="phone-big" href={telHref}><Icon name="phone" weight="fill" size={44} /> {site.phoneDisplay}</a>
        <div class="btn-row">
          <a class="btn btn-yellow" href={waHref()} rel="noopener" target="_blank"><Icon name="whatsapp-logo" size={26} /> Chamar no WhatsApp</a>
        </div>
      </div>
      <div class="hero-stage">
        <PhoneChat />
        <Mascote pose="feliz-acenando" width={230} class="hero-mola" eager alt="Mola, a mascote da M&C, acenando" />
        <p class="float-card"><span class="bd res">Resolvido</span><strong>Água correndo de novo</strong><small>Escoamento testado na hora</small></p>
      </div>
    </div>
  </section>
  <div class="stripe"></div>

  <!-- GARANTIAS -->
  <section class="garantias" aria-label="Por que chamar a M & C">
    <ul class="wrap">
      {garantias.map((g) => (
        <li>
          <Icon name={g.icon} size={34} />
          <div><strong>{g.t}</strong><span>{g.d}</span></div>
        </li>
      ))}
    </ul>
  </section>

  <!-- SERVIÇOS: tabela de oficina -->
  <section class="section" aria-labelledby="serv-t">
    <div class="wrap">
      <h2 id="serv-t">Serviços de desentupimento</h2>
      <p class="lead">Cada entupimento pede uma ferramenta. Escolha o seu problema e veja como resolvemos.</p>
      <ol class="svc">
        {servicos.map((s) => (
          <li class="reveal">
            <a href={`/servicos/${s.slug}`}>
              <span class="svc-ic"><Icon name={s.icon} size={30} /></span>
              <span class="svc-txt">
                <strong>{s.nome}</strong>
                <span>{s.sinais[0]}. {s.resumo}</span>
              </span>
              <span class="svc-go">Ver serviço <Icon name="arrow-right" size={20} /></span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Jornada />

  <!-- EMERGÊNCIA -->
  <section class="emerg" aria-labelledby="emerg-t">
    <div class="wrap">
      <div class="emerg-head">
        <h2 id="emerg-t"><Icon name="warning" weight="fill" size={44} /> Entupiu agora? Faça isso</h2>
        <Mascote pose="concentrado-mostrando" width={170} class="emerg-mola" alt="" />
      </div>
      <ol>
        {emergencia.map((e, i) => (
          <li class="reveal">
            <span class="num" aria-hidden="true">{i + 1}</span>
            <h3>{e.t}</h3>
            <p>{e.d}</p>
          </li>
        ))}
      </ol>
      <a class="btn btn-dark" href={waHref('Olá, M & C! Estou com um entupimento agora em Ubatuba.')} rel="noopener" target="_blank"><Icon name="whatsapp-logo" size={24} /> Mandar foto no WhatsApp</a>
    </div>
  </section>

  <!-- EQUIPAMENTO -->
  <section class="section on-dark equip" aria-labelledby="equip-t">
    <div class="wrap">
      <h2 id="equip-t">Equipamento de verdade</h2>
      <p class="lead">Desentupidora séria não resolve com arame e soda. Estes são os equipamentos que levamos para o seu endereço.</p>
      <ul class="eq">
        {equipamentos.map((e) => (
          <li class="reveal">
            <div class="eq-photo"><Foto nome={e.foto} alt={e.t} sizes="(max-width: 900px) 100vw, 33vw" /></div>
            <Icon name={e.icon} size={40} />
            <h3>{e.t}</h3>
            <p>{e.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ÁREA DE ATENDIMENTO -->
  <section class="section" aria-labelledby="area-t">
    <div class="wrap">
      <h2 id="area-t">Atendemos toda Ubatuba</h2>
      <p class="lead">Do norte ao sul do município, incluindo bairros que dependem de fossa. Toque no seu bairro.</p>
      <div class="area">
        {regioes.map((r) => (
          <div class="reg reveal">
            <h3>{r.nome}</h3>
            <p>{r.desc}</p>
            <ul>
              {bairros.filter((b) => b.regiao === r.nome).map((b) => (
                <li><a href={`/bairros/${b.slug}`}>{b.nome}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="outros">Também atendemos {outrasLocalidades.join(', ')} e demais localidades.</p>
    </div>
  </section>

  {site.googleBusinessUrl && (
    <section class="reviews" aria-labelledby="rev-t">
      <div class="wrap rev-in">
        <div>
          <h2 id="rev-t">Avaliações no Google</h2>
          <p>Veja o que os clientes de Ubatuba dizem sobre a M & C no nosso Perfil da Empresa.</p>
        </div>
        <a class="btn btn-yellow" href={site.googleBusinessUrl} rel="noopener" target="_blank"><Icon name="star" weight="fill" size={22} /> Ver avaliações</a>
      </div>
    </section>
  )}

  <section class="what on-dark" aria-labelledby="oque-t">
    <div class="wrap what-in">
      <h2 id="oque-t">O que faz uma desentupidora em Ubatuba?</h2>
      <div>
        <p>
          Uma desentupidora remove obstruções em pias, vasos sanitários, ralos, redes de esgoto, caixas de gordura e fossas,
          usando máquina rotativa, hidrojateamento e caminhão de sucção. Em Ubatuba, os casos mais comuns são gordura de
          cozinha, areia de praia nos ralos e fossas cheias em casas de temporada.
        </p>
        <p>
          A M & C Desentupidora atende o município inteiro 24 horas, com foco em resolver sem quebrar, combinar o valor antes
          e explicar a causa do problema para que ele não volte.
        </p>
      </div>
    </div>
  </section>

  <Faq faqs={faqHome} title="Dúvidas frequentes" />
  <CtaBand />
</Base>

<style>
  /* HERO */
  .hero { position: relative; overflow: hidden; background: var(--navy); }
  .hero-photo { position: absolute; inset: 0; }
  .hero-photo :global(picture) { height: 100%; }
  .hero-photo :global(img) { opacity: 0.32; filter: grayscale(0.3); }
  .hero { background: radial-gradient(70% 60% at 85% 20%, rgba(30, 110, 220, .3), transparent 60%), radial-gradient(50% 50% at 10% 90%, rgba(242, 104, 12, .1), transparent 60%), linear-gradient(180deg, var(--deep), var(--ink-0)); }
  .hero-photo + .hero-grid { position: relative; }
  .slogan { display: block; margin-top: .25em; font-size: .46em; line-height: 1; color: var(--water-2); }
  .slogan em { font-style: normal; color: var(--yellow); }
  .hero-stage { position: relative; display: grid; place-items: center; min-height: 560px; }
  .hero-stage :global(.hero-mola) { position: absolute; left: -6%; bottom: -6px; z-index: 2; filter: drop-shadow(0 14px 24px rgba(0, 0, 0, .35)); }
  .float-card { position: absolute; left: -12%; top: 29%; z-index: 2; margin: 0; display: grid; gap: 4px; padding: 12px 14px; min-width: 190px; background: rgba(0, 58, 133, .85); border: 1px solid rgba(170, 200, 245, .3); border-radius: var(--radius); backdrop-filter: blur(8px); }
  .float-card strong { font-family: var(--display); font-size: 1.25rem; text-transform: uppercase; line-height: 1; color: var(--white); }
  .float-card small { color: var(--steel-light); }
  .float-card .bd { justify-self: start; }
  .emerg-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; }
  .emerg-head :global(.emerg-mola) { margin-bottom: -20px; flex: none; }
  .hero-grid { position: relative; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.9fr); gap: clamp(32px, 5vw, 72px); align-items: center; padding-block: clamp(40px, 6vw, 88px); }
  .hero-copy h1 { margin-top: 18px; color: var(--white); max-width: 14ch; }
  .hero-copy .lead { color: var(--steel-light); margin-bottom: 26px; }
  .hero-copy .phone-big { margin-bottom: 22px; }

  /* GARANTIAS */
  .garantias { background: var(--white); border-bottom: 1px solid var(--line); }
  .garantias ul { list-style: none; margin: 0 auto; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .garantias li { display: flex; gap: 14px; align-items: flex-start; padding: 26px 20px; border-left: 1px solid var(--line); }
  .garantias li:first-child { border-left: 0; padding-left: 0; }
  .garantias :global(.icon) { color: var(--navy); }
  .garantias strong { display: block; font-family: var(--display); font-weight: 700; font-size: 1.35rem; text-transform: uppercase; line-height: 1.1; }
  .garantias span { color: var(--steel); font-size: 0.96rem; }

  /* SERVIÇOS */
  .svc { list-style: none; margin: 36px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 32px; border-top: 3px solid var(--ink); }
  .svc a { display: grid; grid-template-columns: auto 1fr auto; gap: 18px; align-items: center; padding: 22px 0; border-bottom: 1px solid var(--line); text-decoration: none; color: var(--ink); }
  .svc-ic { display: grid; place-items: center; width: 58px; height: 58px; background: var(--navy); color: var(--white); border-radius: var(--radius); transition: transform var(--t-std) var(--ease), background-color var(--t-std) var(--ease); }
  .svc a:hover .svc-ic { background: var(--yellow); color: var(--ink); transform: rotate(-6deg); }
  .svc-txt strong { display: block; font-family: var(--display); font-weight: 700; font-size: 1.5rem; text-transform: uppercase; line-height: 1.05; }
  .svc-txt span { color: var(--steel); font-size: 0.97rem; }
  .svc-go { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; font-size: 0.95rem; white-space: nowrap; transition: transform var(--t-std) var(--ease); }
  .svc a:hover .svc-go { transform: translateX(4px); }

  /* EMERGÊNCIA */
  .emerg { background: var(--yellow); color: var(--on-yellow); padding-block: clamp(56px, 8vw, 96px); border-block: 6px solid var(--ink); }
  .emerg h2 { display: flex; align-items: center; gap: 14px; }
  .emerg ol { list-style: none; margin: 32px 0 36px; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  .num { display: block; font-family: var(--display); font-weight: 700; font-size: 4.6rem; line-height: 0.8; color: var(--ink); margin-bottom: 10px; -webkit-text-stroke: 0; }
  .emerg h3 { margin-bottom: 6px; }
  .emerg p { margin: 0; font-weight: 600; }

  /* EQUIPAMENTO */
  .eq { list-style: none; margin: 40px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .eq li { border-top: 4px solid var(--yellow); padding-top: 22px; }
  .eq-photo:not(:empty) { aspect-ratio: 4 / 3; margin-bottom: 20px; overflow: hidden; border-radius: var(--radius); }
  .eq-photo :global(picture) { height: 100%; }
  .eq :global(.icon) { color: var(--yellow); margin-bottom: 14px; }
  .eq h3 { color: var(--white); font-size: 1.8rem; }
  .eq p { margin: 0; }

  /* ÁREA */
  .area { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; margin-top: 36px; border: 3px solid var(--ink); background: var(--white); }
  .reg { padding: 26px; }
  .reg + .reg { border-left: 3px solid var(--ink); }
  .reg h3 { font-size: 1.8rem; margin-bottom: 2px; }
  .reg p { color: var(--steel); margin-bottom: 16px; font-size: 0.95rem; }
  .reg ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .reg a { display: inline-block; padding: 8px 12px; background: var(--paper); border: 2px solid var(--ink); border-radius: var(--radius); text-decoration: none; font-weight: 700; transition: background-color var(--t-quick) var(--ease), transform var(--t-quick) var(--ease); }
  .reg a:hover { background: var(--yellow); transform: translateY(-2px); }
  .outros { margin-top: 24px; color: var(--steel); font-size: 0.95rem; max-width: 85ch; }

  /* AVALIAÇÕES */
  .reviews { background: var(--white); border-block: 1px solid var(--line); }
  .rev-in { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 24px; padding-block: 48px; }
  .rev-in p { margin: 0; color: var(--steel); }

  /* O QUE FAZ */
  .what { padding-block: clamp(56px, 8vw, 96px); background: var(--navy-2); }
  .what-in { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.2fr); gap: clamp(28px, 5vw, 72px); }
  .what h2 { color: var(--white); }
  .what p { font-size: 1.1rem; }

  @media (max-width: 960px) {
    .hero-grid, .what-in { grid-template-columns: 1fr; }
    .hero-stage { min-height: 520px; }
    .float-card { left: 0; }
    .garantias ul { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .garantias li:nth-child(3) { border-left: 0; padding-left: 0; }
    .svc { grid-template-columns: 1fr; }
    .emerg ol { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .eq { grid-template-columns: 1fr; }
    .area { grid-template-columns: 1fr; }
    .reg + .reg { border-left: 0; border-top: 3px solid var(--ink); }
  }
  @media (max-width: 560px) {
    .garantias ul { grid-template-columns: 1fr; }
    .garantias li { border-left: 0; padding: 18px 0; border-top: 1px solid var(--line); }
    .garantias li:first-child { border-top: 0; }
    .svc-go { display: none; }
    .svc a { grid-template-columns: auto 1fr; }
    .emerg ol { grid-template-columns: 1fr; }
    .hero .btn { width: 100%; }
    .hero-stage :global(.hero-mola) { width: 140px; left: -2%; }
    .float-card { display: none; }
    .emerg-head :global(.emerg-mola) { width: 110px; }
    .phone-big :global(.icon) { width: 34px; height: 34px; }
  }
</style>
