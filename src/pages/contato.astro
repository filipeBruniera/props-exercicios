---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site, telHref, waHref } from '../data/site';
import { breadcrumbSchema } from '../data/schema';

const title = 'Contato | Desentupidora em Ubatuba 24h | M & C';
const description = `Fale com a M & C Desentupidora em Ubatuba pelo WhatsApp ou telefone ${site.phoneDisplay}. Atendimento 24 horas, todos os dias.`;
const crumbs = [{ name: 'Início', path: '/' }, { name: 'Contato', path: '/contato' }];
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent('Ubatuba, SP')}&output=embed`;
---
<Base title={title} description={description} path="/contato" schema={[breadcrumbSchema(crumbs)]}>
  <section class="section">
    <div class="wrap ct">
      <div>
        <Breadcrumbs items={crumbs} />
        <h1>Fale com a M & C</h1>
        <p class="lead">O WhatsApp é o canal mais rápido. Mande o bairro, o problema e uma foto, se puder.</p>
        <ul class="ch">
          <li><a href={waHref()} rel="noopener" target="_blank"><Icon name="whatsapp-logo" size={28} /><span><strong>WhatsApp</strong>{site.phoneDisplay}</span></a></li>
          <li><a href={telHref}><Icon name="phone" size={28} /><span><strong>Telefone</strong>{site.phoneDisplay}</span></a></li>
          <li><a href={`mailto:${site.email}`}><Icon name="envelope" size={28} /><span><strong>E-mail</strong>{site.email}</span></a></li>
        </ul>
        <p class="muted">{site.hours}. Atendemos todos os bairros de {site.city} - {site.state}.</p>
      </div>
      <div class="map">
        <iframe title="Mapa da área de atendimento em Ubatuba" src={mapSrc} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>
</Base>
<style>
  .ct { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 64px); align-items: start; }
  .ch { list-style: none; margin: 28px 0; padding: 0; display: grid; gap: 12px; }
  .ch a { display: flex; gap: 16px; align-items: center; padding: 18px 20px; border-radius: var(--radius); border: 1px solid var(--line); background: var(--surface); text-decoration: none; color: var(--ink); }
  .ch a:hover { border-color: var(--accent); color: var(--ink); }
  .ch :global(.icon) { color: var(--accent); }
  .ch span { display: grid; word-break: break-word; }
  .map { border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); aspect-ratio: 4 / 5; background: var(--surface-2); }
  .map iframe { width: 100%; height: 100%; border: 0; }
  @media (max-width: 860px) { .ct { grid-template-columns: 1fr; } .map { aspect-ratio: 4 / 3; } }
</style>
