---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { breadcrumbSchema } from '../data/schema';

const title = 'Sobre a M & C Desentupidora | Desentupidora em Ubatuba-SP';
const description = 'Conheça a M & C Desentupidora, empresa de Ubatuba especializada em desentupimento, limpeza de fossa e caixa de gordura, com atendimento 24 horas.';
const crumbs = [{ name: 'Início', path: '/' }, { name: 'Sobre', path: '/sobre' }];
const valores = [
  { icon: 'house-line', t: 'Respeito pelo seu imóvel', d: 'Trabalhamos por dentro da tubulação. Quebra, só quando não houver alternativa e com sua autorização.' },
  { icon: 'receipt', t: 'Preço claro', d: 'O valor é informado depois do diagnóstico e antes de qualquer serviço.' },
  { icon: 'drop', t: 'Cuidado com o litoral', d: 'Resíduos de fossa e caixa de gordura seguem para destinação adequada, longe dos rios e das praias.' },
];
---
<Base title={title} description={description} path="/sobre" schema={[breadcrumbSchema(crumbs)]}>
  <section class="section">
    <div class="wrap about">
      <div>
        <Breadcrumbs items={crumbs} />
        <h1>Desentupidora de Ubatuba, para Ubatuba.</h1>
        <p class="lead">
          A {site.name} atende moradores, pousadas, restaurantes e condomínios de Ubatuba com desentupimento,
          limpeza de fossa e caixa de gordura, hidrojateamento e detecção de vazamento, 24 horas por dia.
        </p>
        <p class="muted">
          Conhecemos os problemas típicos da cidade: areia de praia nos ralos, gordura de cozinha comercial na orla,
          fossas que lotam quando a casa de temporada enche e redes que sofrem com a chuva forte do litoral.
          Por isso chegamos com o equipamento certo para cada caso.
        </p>
      </div>
      <!-- TODO: foto real da equipe ou do veículo da M & C (1200x900). Foto própria aumenta a confiança e ajuda no SEO local. -->
    </div>
  </section>
  <section class="section vals-sec">
    <div class="wrap">
      <h2>O que você pode esperar da M & C</h2>
      <ul class="vals">
        {valores.map((v) => (
          <li class="reveal"><Icon name={v.icon} size={28} /><h3>{v.t}</h3><p>{v.d}</p></li>
        ))}
      </ul>
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .about h1 { max-width: 16ch; }
  .about p { max-width: 64ch; }
  .vals-sec { background: var(--surface); border-top: 1px solid var(--line); }
  .vals { list-style: none; margin: 32px 0 0; padding: 0; display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 28px; }
  .vals :global(.icon) { color: var(--accent); margin-bottom: 14px; }
  .vals p { color: var(--muted); margin: 0; }
  @media (max-width: 860px) { .vals { grid-template-columns: 1fr; } }
</style>
