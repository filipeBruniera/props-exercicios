---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { servicos, type Servico } from '../../data/servicos';
import { bairros } from '../../data/bairros';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../../data/schema';

export function getStaticPaths() {
  return servicos.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
interface Props { s: Servico }
const { s } = Astro.props;
const path = `/servicos/${s.slug}`;
const crumbs = [
  { name: 'Início', path: '/' },
  { name: 'Serviços', path: '/servicos' },
  { name: s.nome, path },
];
const msg = `Olá, M & C! Preciso de ${s.nome.toLowerCase()} em Ubatuba.`;
const atendidoEm = bairros.filter((b) => b.servicos.includes(s.slug));
const outros = servicos.filter((o) => o.slug !== s.slug);
---
<Base title={s.title} description={s.description} path={path}
  schema={[breadcrumbSchema(crumbs), serviceSchema(s), faqSchema(s.faq)]}>
  <PageHero crumbs={crumbs} title={s.h1} lead={s.intro} tag="Atendimento 24h" foto={`servico-${s.slug}`} fotoAlt={`${s.nome} em Ubatuba`} message={msg}>
    <div class="signs">
      <p class="signs-h"><Icon name="warning" weight="fill" size={26} /> Sinais do problema</p>
      <ul>{s.sinais.map((x) => <li>{x}</li>)}</ul>
    </div>
  </PageHero>

  <section class="section" aria-labelledby="proc-t">
    <div class="wrap">
      <h2 id="proc-t">Como fazemos o serviço</h2>
      <ol class="proc">
        {s.processo.map((p, i) => (
          <li class="reveal">
            <span class="num" aria-hidden="true">{i + 1}</span>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="prev-sec" aria-labelledby="prev-t">
    <div class="wrap prev">
      <div class="prev-box reveal">
        <h2 id="prev-t">Para não entupir de novo</h2>
        <ul>{s.prevencao.map((x) => <li><Icon name="check-circle" size={26} /> <span>{x}</span></li>)}</ul>
      </div>
      <div class="areas reveal">
        <h2 class="h-sm">Onde atendemos</h2>
        <p>{s.nome} em todos os bairros de Ubatuba. Mais pedido:</p>
        <ul class="chips">
          {(atendidoEm.length ? atendidoEm : bairros).map((b) => <li><a href={`/bairros/${b.slug}`}>{b.nome}</a></li>)}
        </ul>
        <a class="more" href="/bairros">Todos os bairros <Icon name="arrow-right" size={18} /></a>
      </div>
    </div>
  </section>

  <Faq faqs={s.faq} title={`Dúvidas sobre ${s.curto.toLowerCase()}`} />

  <section class="section other-sec" aria-labelledby="outros-t">
    <div class="wrap">
      <h2 id="outros-t" class="h-sm">Outros serviços</h2>
      <ul class="other">
        {outros.map((o) => (
          <li><a href={`/servicos/${o.slug}`}><span class="o-ic"><Icon name={o.icon} size={24} /></span> {o.nome}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand message={msg} />
</Base>

<style>
  .signs { background: var(--white); color: var(--ink); border: 3px solid var(--ink); box-shadow: 8px 8px 0 var(--yellow); padding: 24px; }
  .signs .signs-h { display: flex; align-items: center; gap: 10px; color: var(--ink); font-family: var(--display); font-weight: 800; font-size: 1.6rem; text-transform: uppercase; line-height: 1; margin: 0 0 12px; padding-bottom: 12px; border-bottom: 3px solid var(--ink); }
  .signs-h :global(.icon) { color: #b45309; }
  .signs ul { margin: 0; padding-left: 1.1rem; display: grid; gap: 8px; font-weight: 600; }
  .proc { list-style: none; margin: 36px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; border: 3px solid var(--ink); background: var(--white); }
  .proc li { padding: 26px 22px; }
  .proc li + li { border-left: 3px solid var(--ink); }
  .num { display: inline-grid; place-items: center; width: 48px; height: 48px; background: var(--yellow); font-family: var(--display); font-weight: 800; font-size: 1.8rem; border: 2px solid var(--ink); margin-bottom: 14px; }
  .proc p { margin: 0; color: var(--steel); }
  .prev-sec { background: var(--yellow); border-block: 6px solid var(--ink); padding-block: clamp(48px, 7vw, 88px); }
  .prev { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 64px); align-items: start; }
  .prev-box ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; font-weight: 600; font-size: 1.08rem; }
  .prev-box li { display: flex; gap: 12px; }
  .areas { background: var(--white); border: 3px solid var(--ink); padding: 24px; }
  .h-sm { font-size: 1.9rem; }
  .areas p { color: var(--steel); }
  .chips { list-style: none; margin: 0 0 16px; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips a { display: inline-block; padding: 7px 11px; border: 2px solid var(--ink); border-radius: var(--radius); text-decoration: none; font-weight: 700; transition: background-color var(--t-quick) var(--ease); }
  .chips a:hover { background: var(--yellow); }
  .more { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; }
  .other-sec { padding-top: 0; }
  .other { list-style: none; margin: 20px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; }
  .other a { display: flex; align-items: center; gap: 12px; padding: 12px; border: 2px solid var(--ink); background: var(--white); text-decoration: none; font-weight: 700; border-radius: var(--radius); transition: transform var(--t-quick) var(--ease), box-shadow var(--t-quick) var(--ease); }
  .other a:hover { transform: translate(-2px, -2px); box-shadow: 4px 4px 0 var(--yellow); }
  .o-ic { display: grid; place-items: center; width: 40px; height: 40px; background: var(--navy); color: var(--yellow); flex: none; }
  @media (max-width: 900px) {
    .prev { grid-template-columns: 1fr; }
    .proc { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .proc li:nth-child(3) { border-left: 0; }
    .proc li:nth-child(n + 3) { border-top: 3px solid var(--ink); }
  }
  @media (max-width: 560px) {
    .proc { grid-template-columns: 1fr; }
    .proc li + li { border-left: 0; border-top: 3px solid var(--ink); }
  }
</style>
