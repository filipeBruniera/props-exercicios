---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { telHref, waHref, site } from '../../data/site';
import { servicos, type Servico } from '../../data/servicos';
import { bairros } from '../../data/bairros';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../../data/schema';

export function getStaticPaths() {
  return servicos.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
interface Props { s: Servico }
const { s } = Astro.props;
const path = `/servicos/${s.slug}`;
const crumbs = [
  { name: 'Início', path: '/' },
  { name: 'Serviços', path: '/servicos' },
  { name: s.nome, path },
];
const msg = `Olá, M & C! Preciso de ${s.nome.toLowerCase()} em Ubatuba.`;
const atendidoEm = bairros.filter((b) => b.servicos.includes(s.slug));
const outros = servicos.filter((o) => o.slug !== s.slug);
---
<Base title={s.title} description={s.description} path={path}
  schema={[breadcrumbSchema(crumbs), serviceSchema(s), faqSchema(s.faq)]}>
  <section class="svc-hero">
    <div class="wrap svc-grid">
      <div class="hero-in">
        <Breadcrumbs items={crumbs} />
        <h1>{s.h1}</h1>
        <p class="lead">{s.intro}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={waHref(msg)} rel="noopener" target="_blank"><Icon name="whatsapp-logo" size={22} /> Chamar no WhatsApp</a>
          <a class="btn btn-ghost" href={telHref}><Icon name="phone" size={20} /> Ligar agora</a>
        </div>
      </div>
      <aside class="signs" aria-labelledby="sinais-t">
        <h2 id="sinais-t" class="h-small"><Icon name="warning" size={22} /> Sinais de que você precisa</h2>
        <ul>{s.sinais.map((x) => <li>{x}</li>)}</ul>
        <p class="signs-foot">{site.hours}.</p>
      </aside>
    </div>
  </section>

  <section class="section proc-sec" aria-labelledby="proc-t">
    <div class="wrap">
      <h2 id="proc-t">Como fazemos o serviço</h2>
      <ol class="proc">
        {s.processo.map((p) => (
          <li class="reveal"><h3>{p.titulo}</h3><p>{p.texto}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="prev-t">
    <div class="wrap prev">
      <div class="prev-box reveal">
        <h2 id="prev-t">Como evitar que volte a entupir</h2>
        <ul>{s.prevencao.map((x) => <li><Icon name="check-circle" size={22} /> <span>{x}</span></li>)}</ul>
      </div>
      <div class="areas reveal">
        <h2 class="h-small">{s.nome} nos bairros de Ubatuba</h2>
        <p class="muted">Atendemos todos os bairros. Veja onde este serviço é mais pedido:</p>
        <ul class="pills">
          {(atendidoEm.length ? atendidoEm : bairros).map((b) => <li><a href={`/bairros/${b.slug}`}>{b.nome}</a></li>)}
        </ul>
        <p><a href="/bairros">Ver todos os bairros atendidos</a></p>
      </div>
    </div>
  </section>

  <Faq faqs={s.faq} title={`Dúvidas sobre ${s.nome.toLowerCase()}`} />

  <section class="section other-sec" aria-labelledby="outros-t">
    <div class="wrap">
      <h2 id="outros-t" class="h-small">Outros serviços em Ubatuba</h2>
      <ul class="other">
        {outros.map((o) => (
          <li><a href={`/servicos/${o.slug}`}><Icon name={o.icon} size={22} /> {o.nome}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand message={msg} />
</Base>

<style>
  .svc-hero { padding-block: clamp(32px, 5vw, 72px); }
  .svc-grid { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.8fr); gap: clamp(28px, 5vw, 64px); align-items: end; }
  .svc-grid h1 { font-size: clamp(2.1rem, 4.6vw, 3.4rem); }
  .svc-grid .lead { margin-bottom: 28px; }
  .h-small { font-size: 1.25rem; display: flex; align-items: center; gap: 10px; }
  .signs { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; }
  .signs :global(.icon) { color: var(--accent); }
  .signs ul { margin: 0 0 16px; padding-left: 1.1rem; display: grid; gap: 8px; }
  .signs-foot { margin: 0; font-size: 0.9rem; color: var(--muted); }
  .proc-sec { background: var(--deep); color: var(--on-deep); }
  .proc { list-style: none; counter-reset: p; margin: 36px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; }
  .proc li { counter-increment: p; border-top: 2px solid var(--accent-on-deep); padding-top: 18px; }
  .proc li::before { content: counter(p); font-weight: 700; color: var(--accent-on-deep); font-size: 0.95rem; display: block; margin-bottom: 6px; }
  .proc p { color: var(--on-deep-muted); margin: 0; }
  .prev { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 64px); align-items: start; }
  .prev-box { background: var(--accent-soft); border-radius: var(--radius); padding: clamp(24px, 4vw, 44px); }
  .prev-box ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .prev-box li { display: flex; gap: 12px; }
  .prev-box :global(.icon) { color: var(--accent); margin-top: 2px; }
  .pills { list-style: none; margin: 16px 0 20px; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .pills a { display: inline-block; padding: 8px 15px; border-radius: var(--pill); border: 1px solid var(--line); background: var(--surface); text-decoration: none; font-weight: 520; }
  .pills a:hover { border-color: var(--accent); color: var(--accent); }
  .other-sec { padding-top: 0; }
  .other { list-style: none; margin: 20px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 10px; }
  .other a { display: flex; align-items: center; gap: 10px; padding: 14px 16px; border-radius: 12px; border: 1px solid var(--line); background: var(--surface); text-decoration: none; font-weight: 550; }
  .other a:hover { border-color: var(--accent); }
  .other :global(.icon) { color: var(--accent); }
  @media (max-width: 900px) {
    .svc-grid, .prev { grid-template-columns: 1fr; }
    .proc { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) { .proc { grid-template-columns: 1fr; } .svc-hero .btn-row .btn { flex: 1 1 100%; } }
</style>
