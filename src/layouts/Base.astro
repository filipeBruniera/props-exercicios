---
import '@fontsource/questrial/latin-400.css';
import '@fontsource/cormorant-garamond/latin-600.css';
import '@fontsource/cormorant-garamond/latin-700.css';
import '@fontsource/julius-sans-one/latin-400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import { site, absUrl } from '../data/site';
import { businessSchema, websiteSchema, webPageSchema } from '../data/schema';

interface Props {
  title: string;
  description: string;
  path: string;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}
const { title, description, path, schema = [], noindex = false } = Astro.props;
const canonical = absUrl(path);
const ogImage = absUrl('/og.png');
// Liga breadcrumb e FAQ à WebPage da página (ids estáveis por URL)
const page = webPageSchema(path, title, description);
const extras = schema.map((n) => {
  if (n['@type'] === 'BreadcrumbList') {
    page.breadcrumb = { '@id': `${canonical}#breadcrumb` };
    return { '@id': `${canonical}#breadcrumb`, ...n };
  }
  if (n['@type'] === 'FAQPage') return { '@id': `${canonical}#faq`, url: canonical, mainEntityOfPage: { '@id': page['@id'] }, ...n };
  return n;
});
const graph = {
  '@context': 'https://schema.org',
  '@graph': [businessSchema(), websiteSchema(), page, ...extras],
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
    <meta name="theme-color" content="#002252" />
    <meta name="geo.region" content="BR-SP" />
    <meta name="geo.placename" content="Ubatuba" />
    <meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />
    <meta name="ICBM" content={`${site.geo.lat}, ${site.geo.lng}`} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />

    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(graph)} />}
  </head>
  <body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppFab />
  </body>
</html>
