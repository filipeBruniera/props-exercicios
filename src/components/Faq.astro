---
import type { Faq } from '../data/servicos';
interface Props { faqs: Faq[]; title?: string }
const { faqs, title = 'Perguntas frequentes' } = Astro.props;
---
<section class="section faq" aria-labelledby="faq-t">
  <div class="wrap faq-grid">
    <h2 id="faq-t">{title}</h2>
    <div class="faq-list">
      {faqs.map((f) => (
        <details class="reveal">
          <summary><h3>{f.q}</h3></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .faq-grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr); gap: 48px; align-items: start; }
  .faq-list { display: grid; gap: 12px; }
  details { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 4px 22px; }
  summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 16px 0; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; font-size: 1.5rem; line-height: 1; color: var(--accent); transition: transform 0.2s; }
  details[open] summary::after { transform: rotate(45deg); }
  summary h3 { margin: 0; font-size: 1.05rem; }
  details p { color: var(--muted); padding-bottom: 8px; max-width: 65ch; }
  @media (max-width: 860px) { .faq-grid { grid-template-columns: 1fr; gap: 24px; } }
</style>
