---
import type { Faq } from '../data/servicos';
interface Props { faqs: Faq[]; title?: string }
const { faqs, title = 'Perguntas frequentes' } = Astro.props;
---
<section class="section faq" aria-labelledby="faq-t">
  <div class="wrap faq-grid">
    <h2 id="faq-t">{title}</h2>
    <div class="faq-list">
      {faqs.map((f) => (
        <details>
          <summary><h3>{f.q}</h3><span class="pm" aria-hidden="true"></span></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .faq-grid { display: grid; grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.5fr); gap: 48px; align-items: start; }
  .faq-list { border-top: 3px solid var(--ink); }
  details { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 20px 0; }
  summary::-webkit-details-marker { display: none; }
  summary h3 { margin: 0; font-family: var(--body); text-transform: none; font-size: 1.12rem; font-weight: 700; line-height: 1.35; }
  .pm { position: relative; flex: 0 0 28px; height: 28px; background: var(--yellow); border-radius: 2px; }
  .pm::before, .pm::after { content: ''; position: absolute; left: 7px; right: 7px; top: 12.5px; height: 3px; background: var(--ink); transition: transform var(--t-std) var(--ease); }
  .pm::after { transform: rotate(90deg); }
  details[open] .pm::after { transform: rotate(0deg); }
  details p { color: var(--steel); padding-bottom: 12px; max-width: 68ch; }
  @media (max-width: 860px) { .faq-grid { grid-template-columns: 1fr; gap: 20px; } }
</style>
