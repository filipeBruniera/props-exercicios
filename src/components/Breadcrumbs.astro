---
interface Props { items: { name: string; path: string }[] }
const { items } = Astro.props;
---
<nav aria-label="Você está em" class="crumbs">
  <ol>
    {items.map((it, i) => (
      <li>{i < items.length - 1 ? <a href={it.path}>{it.name}</a> : <span aria-current="page">{it.name}</span>}</li>
    ))}
  </ol>
</nav>
<style>
  .crumbs ol { list-style: none; margin: 0 0 20px; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; font-size: 0.92rem; font-weight: 600; color: var(--steel-light); }
  .crumbs li + li::before { content: '›'; margin-right: 6px; color: var(--yellow); }
  .crumbs a { color: var(--steel-light); text-decoration: none; }
  .crumbs a:hover { color: var(--white); }
  .crumbs [aria-current] { color: var(--white); }
</style>
