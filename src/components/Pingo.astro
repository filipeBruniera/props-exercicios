---
/**
 * Pingo, o mascote da M&C (arquivos oficiais do kit: brand/kit/03-mascote-pingo).
 * Renderiza a pose como <img> SVG estático: leve, sem JavaScript.
 * pose: "expressao-pose", ex. "feliz-acenando", "comemorando-comemorando".
 */
const urls = import.meta.glob<string>('../assets/pingo/*.svg', { query: '?url', import: 'default', eager: true });
const raws = import.meta.glob<string>('../assets/pingo/*.svg', { query: '?raw', import: 'default', eager: true });

interface Props {
  pose: string;
  width?: number;
  alt?: string;
  class?: string;
  eager?: boolean;
}
const { pose, width = 200, alt = 'Pingo, o mascote da M&C Desentupidora', class: className, eager = false } = Astro.props;
const key = Object.keys(urls).find((k) => k.endsWith(`/${pose}.svg`));
if (!key) throw new Error(`Pose do Pingo não encontrada: ${pose}`);
const vb = raws[key].match(/viewBox="([-\d.]+) ([-\d.]+) ([\d.]+) ([\d.]+)"/);
const height = vb ? Math.round((width * +vb[4]) / +vb[3]) : width;
---
<img src={urls[key]} width={width} height={height} alt={alt} class:list={['pingo', className]} loading={eager ? 'eager' : 'lazy'} decoding="async" />
