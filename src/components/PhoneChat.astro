---
// Celular com o atendimento no WhatsApp (componente do brand book M&C Fluxo).
// As mensagens entram em sequência só com CSS; com menos movimento, aparecem paradas.
import simbolo from '../assets/marca/simbolo-mc.svg?raw';
const sym = simbolo.replace(/<title>.*?<\/title>/, '').replace(/ width="\d+" height="\d+"/, '').replace(/ role="img" aria-label="[^"]*"/, ' aria-hidden="true"');
---
<figure class="phone" aria-label="Exemplo de atendimento da M&C pelo WhatsApp">
  <div class="notch" aria-hidden="true"></div>
  <div class="scr">
    <div class="wa-top"><span class="av"><Fragment set:html={sym} /></span><span><b>M&amp;C Desentupidora</b><small>online</small></span></div>
    <div class="wa-body">
      <p class="msg me">Boa noite! A pia da cozinha entupiu e a água está voltando<time>23:41</time></p>
      <p class="msg me"><span class="photo" role="img" aria-label="Foto da pia enviada pelo cliente"></span><time>23:41</time></p>
      <p class="msg">Boa noite! Recebemos a foto. É gordura no sifão. Resolvemos sem quebrar.<time>23:42</time></p>
      <div class="quote"><span class="k">Orçamento · Pia <span class="ex">exemplo</span></span><span class="v">R$ 000,00</span><span class="k">Itaguá · hoje</span><span class="ok">Aprovar orçamento</span></div>
      <p class="status"><span class="bd cam">A caminho</span> chegada em 25 min</p>
    </div>
    <div class="wa-in" aria-hidden="true"><span>Mensagem</span><i></i></div>
  </div>
  <figcaption class="sr-only">Conversa ilustrativa: o cliente manda a foto, recebe o orçamento e o técnico sai a caminho.</figcaption>
</figure>
<style>
  .phone { position: relative; width: 290px; aspect-ratio: 9 / 18.5; border-radius: 40px; background: #0a0f18; padding: 10px; margin: 0; box-shadow: 0 0 0 2px #2a3446, 0 40px 80px rgba(0, 0, 0, .5), inset 0 0 0 2px #1a2232; }
  .scr { position: relative; width: 100%; height: 100%; border-radius: 31px; overflow: hidden; background: #ece5dd; color: var(--ink); display: flex; flex-direction: column; font-size: 13px; line-height: 1.35; }
  .notch { position: absolute; top: 9px; left: 50%; transform: translateX(-50%); width: 86px; height: 22px; border-radius: 12px; background: #0a0f18; z-index: 2; }
  .wa-top { background: #075e54; color: #fff; padding: 36px 12px 10px; display: flex; align-items: center; gap: 10px; }
  .wa-top b { display: block; font-size: 14px; }
  .wa-top small { opacity: .85; font-size: 11px; }
  .av { width: 34px; height: 34px; border-radius: 50%; background: var(--navy); display: grid; place-items: center; overflow: hidden; flex: none; }
  .av :global(svg) { width: 30px; height: auto; }
  .wa-body { flex: 1; padding: 12px 10px; display: flex; flex-direction: column; gap: 7px; overflow: hidden; }
  .scr p { color: var(--ink); }
  .msg { margin: 0; max-width: 84%; padding: 7px 9px 5px; border-radius: 8px; background: #fff; box-shadow: 0 1px 1px rgba(0, 0, 0, .1); }
  .msg.me { align-self: flex-end; background: #dcf8c6; }
  .msg time { display: block; text-align: right; font-size: 10px; color: #5b6b5b; }
  .photo { display: block; height: 82px; border-radius: 6px; margin-bottom: 4px; background: linear-gradient(160deg, #b9c3cc, #8b97a3); position: relative; }
  .photo::before { content: ''; position: absolute; left: 22%; top: 28%; width: 56%; height: 40%; border-radius: 0 0 40% 40%; background: #e7ecf0; box-shadow: inset 0 -10px 0 #6b5a43; }
  .quote { background: #fff; border-radius: 8px; border-left: 4px solid var(--yellow); padding: 9px 10px; display: grid; gap: 3px; }
  .quote .k { font-family: var(--mono); font-size: 10px; color: var(--steel); display: flex; justify-content: space-between; gap: 6px; }
  .quote .v { font-family: var(--display); font-weight: 800; font-size: 26px; line-height: 1; }
  .quote .ok { margin-top: 4px; background: var(--wa); color: #fff; text-align: center; border-radius: 6px; padding: 6px; font-weight: 700; font-size: 12px; }
  .scr .status { margin: 0; align-self: center; display: flex; gap: 6px; align-items: center; font-size: 11px; font-weight: 600; color: var(--steel); }
  .wa-in { background: #f0f0f0; padding: 8px; display: flex; gap: 6px; }
  .wa-in span { flex: 1; background: #fff; border-radius: 18px; padding: 7px 12px; color: #767676; font-size: 12px; }
  .wa-in i { width: 32px; height: 32px; border-radius: 50%; background: #075e54; }
  @media (prefers-reduced-motion: no-preference) {
    .wa-body > * { animation: pop .35s var(--ease) both; }
    .wa-body > *:nth-child(1) { animation-delay: .6s; }
    .wa-body > *:nth-child(2) { animation-delay: 1.1s; }
    .wa-body > *:nth-child(3) { animation-delay: 1.7s; }
    .wa-body > *:nth-child(4) { animation-delay: 2.3s; }
    .wa-body > *:nth-child(5) { animation-delay: 2.9s; }
  }
  @keyframes pop { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @media (max-width: 560px) { .phone { width: 250px; } .wa-body > :nth-child(2) { display: none; } }
</style>
