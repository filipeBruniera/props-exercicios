---
interface Props { invert?: boolean }
const { invert = false } = Astro.props;
---
<a href="/" class:list={['logo', { invert }]}>
  <span class="mark">M&amp;C</span>
  <span class="word">Desentupidora<small>Ubatuba 24h</small></span>
</a>
<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--white); }
  .logo.invert { color: var(--ink); }
  .mark { font-family: var(--display); font-weight: 800; font-size: 1.55rem; line-height: 1; background: var(--yellow); color: var(--on-yellow); padding: 7px 9px 5px; border-radius: 2px; transform: skewX(-8deg); letter-spacing: 0.01em; }
  .word { display: grid; font-family: var(--display); font-weight: 800; font-size: 1.3rem; line-height: 0.95; text-transform: uppercase; }
  .word small { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.12em; color: var(--yellow); }
  .invert .word small { color: var(--steel); }
</style>
