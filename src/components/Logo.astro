---
import { site } from '../data/site';
---
<a href="/" class="logo" aria-label={`${site.name}, página inicial`}>
  <svg width="36" height="36" viewBox="0 0 36 36" aria-hidden="true">
    <rect width="36" height="36" rx="10" fill="var(--accent)" />
    <path d="M9 25V11l9 9 9-9v14" fill="none" stroke="var(--on-accent)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <span class="logo-text"><strong>M &amp; C</strong> Desentupidora</span>
</a>
<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink); }
  .logo:hover { color: var(--ink); }
  .logo-text { font-size: 1.05rem; letter-spacing: -0.01em; white-space: nowrap; }
  .logo-text strong { font-weight: 750; }
</style>
