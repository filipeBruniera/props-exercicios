---
import Icon from './Icon.astro';
import { site, telHref, waHref } from '../data/site';
interface Props { title?: string; message?: string }
const { title = 'Entupiu? A gente resolve hoje.', message } = Astro.props;
---
<section class="cta" aria-label="Chamar a desentupidora">
  <div class="stripe"></div>
  <div class="wrap cta-in">
    <div>
      <h2>{title}</h2>
      <p>Plantão 24 horas em toda Ubatuba. Valor combinado antes de começar.</p>
    </div>
    <div class="cta-act">
      <a class="phone" href={telHref}><Icon name="phone" weight="fill" size={36} /> {site.phoneDisplay}</a>
      <a class="btn btn-dark" href={waHref(message)} rel="noopener" target="_blank"><Icon name="whatsapp-logo" size={24} /> Chamar no WhatsApp</a>
    </div>
  </div>
</section>
<style>
  .cta { background: var(--yellow); color: var(--on-yellow); }
  .cta-in { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 28px; padding-block: clamp(40px, 6vw, 72px); }
  h2 { margin-bottom: 0.2em; }
  p { margin: 0; font-weight: 600; font-size: 1.1rem; }
  .cta-act { display: grid; gap: 14px; justify-items: start; }
  .phone { display: inline-flex; align-items: center; gap: 10px; font-family: var(--display); font-weight: 800; font-size: clamp(2.2rem, 5vw, 3.4rem); line-height: 1; text-decoration: none; color: var(--ink); white-space: nowrap; }
</style>
