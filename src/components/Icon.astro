---
// Ícones Phosphor (biblioteca oficial), embutidos como SVG inline no build.
const icons = import.meta.glob<string>(
  '../../node_modules/@phosphor-icons/core/assets/regular/*.svg',
  { query: '?raw', import: 'default', eager: true },
);

interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 24, class: className } = Astro.props;
const key = Object.keys(icons).find((k) => k.endsWith(`/${name}.svg`));
if (!key) throw new Error(`Ícone Phosphor não encontrado: ${name}`);
const svg = icons[key]
  .replace('<svg ', `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false" class="icon ${className ?? ''}" `);
---
<Fragment set:html={svg} />
